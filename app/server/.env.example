# Optional. Market data works without any of this -- every chain, candle and
# ticker endpoint the desk reads is public.
#
# Set these to see your own balances and positions. Use a NEW key; do not reuse
# a key that has ever been pasted into a chat, a screenshot, or a file in this
# repo -- treat any such key as public and revoke it.
#
# Give the key read-only permissions unless you intend to trade from here. A key
# with trading rights is a key that can empty the account if it leaks.
DELTA_API_KEY=
DELTA_API_SECRET=

# The live-order switch. Everything below is off unless this is exactly "1".
#
#   unset / 0  -> paper. Orders are simulated against a local book. Nothing
#                 reaches the exchange, and the screen says "paper" on it.
#   1          -> live. Orders placed from the desk are real, spend real margin
#                 and can lose real money.
#
# It also needs DELTA_API_KEY and DELTA_API_SECRET above: with no credentials
# the desk stays on paper whatever this says.
DELTA_LIVE_TRADING=0

PORT=8787

# Sign-in. Without these the API answers nothing but /api/health and /api/me:
# the desk shows your position sizing and, with a key set, your balances, so it
# is never open. The trading engine still runs and still exits positions.
#
# These two seed the FIRST user into auth.db and are then ignored -- the
# password afterwards lives in auth.db and is changed on the desk's profile
# screen (or with `npm run auth -- set-password`).
#
# Generate the hash -- never store the password itself:
#   cd app/server && npx tsx hash-password.mjs
DESK_USER=
DESK_PASSWORD_HASH=

# Required, and a real secret: it seals the authenticator secret and the
# recovery codes in auth.db.
#   openssl rand -base64 32
# Rotating it signs everyone out AND makes the sealed authenticator secret
# unreadable, so two-step sign-in has to be set up again:
#   npm run auth -- reset-2fa
DESK_SESSION_SECRET=

# Optional. Extra origins allowed to send a change (POST/PUT/DELETE) besides
# the desk's own host. Comma-separated, full origins. Normally left empty.
DESK_ALLOWED_ORIGINS=

# Sessions last 24 hours from sign-in. Two-step sign-in (Google Authenticator)
# is required and cannot be turned off from the web; if the phone is lost, use
# a recovery code, or `npm run auth -- reset-2fa` on the server.

# Optional. A Telegram message when an order fills -- the entry, and the exit
# with its P&L. Leave either blank and nothing is sent.
#
#   TG_TOKEN    from @BotFather. It is a password for the bot: anyone holding it
#               can post as the bot. Never commit it, and revoke it (/revoke in
#               BotFather) if it is ever pasted into a chat or a screenshot.
#   TG_CHAT_ID  your chat with the bot. Send the bot any message, then read
#               "chat":{"id":...} from https://api.telegram.org/bot<TOKEN>/getUpdates
TG_TOKEN=
TG_CHAT_ID=
