# Optional. Market data works without any of this -- every chain, candle and
# ticker endpoint the desk reads is public.
#
# Set these to see your own balances and positions. Use a NEW key; do not reuse
# a key that has ever been pasted into a chat, a screenshot, or a file in this
# repo -- treat any such key as public and revoke it.
#
# Give the key read-only permissions unless you intend to trade from here. A key
# with trading rights is a key that can empty the account if it leaks.
DELTA_API_KEY=
DELTA_API_SECRET=

# The live-order switch. Everything below is off unless this is exactly "1".
#
#   unset / 0  -> paper. Orders are simulated against a local book. Nothing
#                 reaches the exchange, and the screen says "paper" on it.
#   1          -> live. Orders placed from the desk are real, spend real margin
#                 and can lose real money.
#
# It also needs DELTA_API_KEY and DELTA_API_SECRET above: with no credentials
# the desk stays on paper whatever this says.
DELTA_LIVE_TRADING=0

PORT=8787

# Optional. Set all three to put a login in front of the desk. Without them the
# page is open to anyone who knows the address, which matters because it shows
# your position sizing and, with a key set, your balances.
#
# Generate the hash -- never store the password itself:
#   cd app/server && npx tsx hash-password.mjs
DESK_USER=
DESK_PASSWORD_HASH=
# Any long random string. Rotating it signs everyone out.
DESK_SESSION_SECRET=
DESK_SESSION_HOURS=24
