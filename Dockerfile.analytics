# syntax=docker/dockerfile:1.7

# The analytics service: display-only models for the desk's screens.
#
# No credentials, no host port, no route to an order. The API calls it over the
# compose network and shows its own figures whenever it does not answer.

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv/analytics

# manifests first, so a source-only change reuses the install layer
COPY analytics/requirements.txt ./
RUN --mount=type=cache,target=/root/.cache/pip pip install --no-compile -r requirements.txt

COPY analytics/app ./app

# An unprivileged user. The tables it reads are in PostgreSQL (DATABASE_URL,
# set by compose); it owns no files.
RUN useradd --system --uid 1000 --no-create-home analytics
USER analytics

EXPOSE 8800
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8800/health', timeout=4).status == 200 else 1)"

# Two workers: the model is pure Python and CPU-bound per request, and the API
# keeps three of the four cores.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8800", "--workers", "2", "--no-server-header"]
