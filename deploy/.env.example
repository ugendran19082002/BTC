# Read by docker compose from this directory (deploy/.env). Copy this file to
# deploy/.env and fill it in; deploy.sh ships it to the server beside the compose
# file. Never commit deploy/.env.
#
# The database password. The db container is created with it and the API and
# analytics containers connect with it; nothing outside the compose network can
# reach the database at all.
#   openssl rand -base64 24
POSTGRES_PASSWORD=
