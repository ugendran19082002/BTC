[Unit]
Description=BTC Options Desk API (Fastify)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=btcdesk
WorkingDirectory=/srv/btc-desk/app/server
Environment=NODE_ENV=production
Environment=PORT=8787
# Credentials, if any, live here and nowhere else. Mode 0600, owned by btcdesk.
EnvironmentFile=-/srv/btc-desk/app/server/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3

# The API only reads public market data and a read-only account view; it has no
# reason to write anywhere except its own chain cache.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/btc-desk/chain
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
